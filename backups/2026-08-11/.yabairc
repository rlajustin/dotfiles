yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# bsp or float (default: bsp)
# yabai -m config layout stack 

# Override default layout for space 2 only
#yabai -m config --space 2 layout bsp

# Set all padding and gaps to 10pt (default: 0)
yabai -m config			\
	top_padding    8	\
	bottom_padding 8	\
	left_padding   8	\
	right_padding  8	\
	window_gap     8	

yabai -m config						\
	window_shadow off				\
	split_ratio			0.5		\
	split_type			auto		\
#	auto_balance			false		\
#	window_placement		second_child

# TODO: IN FLOAT SETTING, ALLOW CHANGING OF WINDOW ORDER (MAYBE ADD SKHD HOTKEY)

yabai -m config mouse_drop_action swap #swap|stack
yabai -m config mouse_modifier 	ctrl #[cmd|alt|shift|ctrl|fn]
yabai -m config mouse_action1	move
yabai -m config mouse_action2	resize

yabai -m config external_bar all:35:0

yabai -m rule --add app="^zathura$" manage=on

yabai -m signal --add event=window_destroyed action="yabai -m query --windows --window &> /dev/null || yabai -m window --focus mouse"
yabai -m signal --add event=application_terminated action="yabai -m query --windows --window &> /dev/null || yabai -m window --focus mouse"

osascript -e 'tell application id "tracesOf.Uebersicht" to refresh'
