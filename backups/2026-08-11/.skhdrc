#:: default : ~/.config/ubersicht/widgets/simple-bar/lib/scripts/yabai-set-mode.sh default
# THIS JUST MEANS ALL KEYPRESSES GETS ABSORBED BY SKHD
#:: test @ : ~/.config/ubersicht/widgets/simple-bar/lib/scripts/yabai-set-mode.sh test red
#:: awake : ~/.config/ubersicht/widgets/simple-bar/lib/scripts/yabai-set-mode.sh awake blue
#:: off : ~/.config/ubersicht/widgets/simple-bar/lib/scripts/yabai-set-mode.sh off red 
#:: asleep : ~/.config/ubersicht/widgets/simple-bar/lib/scripts/yabai-set-mode.sh asleep red

#awake, asleep < alt + shift - 0 ; default
#default, asleep < alt + shift - 1 ; awake
#default, awake < alt + shift - 2 ; asleep

#awake < alt + shift - b : yabai -m space --layout bsp
#awake < alt + shift - f : yabai -m space --layout float
#awake < alt + shift - s : yabai -m space --layout stack

alt + shift - b : yabai -m space --layout bsp
alt + shift - f : yabai -m space --layout float
alt + shift - s : yabai -m space --layout stack 

alt + shift - 1 : yabai -m space --focus 1
alt + shift - 2 : yabai -m space --focus 2
alt + shift - 3 : yabai -m space --focus 3
alt + shift - 4 : yabai -m space --focus 4
alt + shift - 5 : yabai -m space --focus 5
alt + shift - 6 : yabai -m space --focus 6
alt + shift - 7 : yabai -m space --focus 7
alt + shift - 8 : yabai -m space --focus 8
alt + shift - 9 : yabai -m space --focus 9

#default < cmd + shift - return : /Applications/Warp.app/Contents/MacOS/stable
#awake < alt - return : /Applications/iTerm.app/Contents/MacOS/iTerm2
#awake < alt + shift - return : /Applications/Thorium.app/Contents/MacOS/Thorium

alt - return : /Applications/iTerm.app/Contents/MacOS/iTerm2
