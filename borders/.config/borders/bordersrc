#!/usr/bin/env sh

# Rosé Pine Dawn: text for the focused window, muted for inactive windows.
config_path=$(realpath "$0")
config_dir=$(dirname "$config_path")
borders_root=$(CDPATH= cd -- "$config_dir/../.." && pwd)

exec "$borders_root/bin/borders" \
  style=round \
  active_color=0xff575279 \
  inactive_color=0xff9893a5 \
  width=4.0 \
  hidpi=on
